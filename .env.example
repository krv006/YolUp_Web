# Nusxa oling: cp .env.example .env
# Vercel'da ham xuddi shu nomlar bilan (Project Settings > Environment Variables) beriladi.

# "/" yoki API'ning to'liq manzili. Amalda so'rovlar VITE_WS_URL domeniga to'g'ridan-to'g'ri yuboriladi.
VITE_API_URL=/

# WebSocket manzili (chat, doska, bildirishnomalar). Test server: wss://edu.thesofmebel.uz
VITE_WS_URL=wss://edu.thesofmebel.uz

# Faqat `npm run dev`: /api so'rovlari shu serverga proksi qilinadi (bo'sh bo'lsa https://edu.thesofmebel.uz)
# VITE_API_PROXY_TARGET=http://localhost:8000

# Ixtiyoriy
# VITE_REQUEST_TIMEOUT=15000
# VITE_APP_NAME=Fokus
# VITE_APP_ENV=development
